@using Fanex.MailDelivery.Core.Models;
@using System.Collections.Generic;
@{
    List<ClientStatusModel> newClients = Model.Item1;
    List<ClientStatusModel> onlines = Model.Item2;
    List<ClientStatusModel> offlines = Model.Item3;
    List<string> ips = Model.Item4;
}

<div style="font-family:Verdana, Geneva, Tahoma, sans-serif; font-size:10pt">
    <div>
        Dear Admin, <br /> <br />

        Please find the details below for the latest status of mail services integrated with Mail Station. <br /><br />
        The service is running on server: <br /><br />
        <ul>
            @foreach (string ip in @ips)
            {
                <li>
                    <span>@ip</span>
                </li>
            }
        </ul>
    </div>
    <div>
        1> NEW service(s):
    </div>
    <div>
        <ul>
            @foreach (ClientStatusModel status in @newClients)
            {

                <li>
                    <span>@status.MailName</span>
                </li>


            }
        </ul>
        <br />
    </div>

    <div>
        2> DISCONNECTED service(s):
    </div>
    <div>
        <ul>
            @foreach (ClientStatusModel status in @offlines)
            {

                <li>
                    <span>@status.MailName</span>
                </li>

                
            }
        </ul>
        <br />
    </div>

    <div>
        3> RE-CONNECTED service(s):
    </div>
    <div>
        <ul>
            @foreach (ClientStatusModel status in @onlines)
            {

                <li>
                    <span>@status.MailName</span>
                </li>

                
            }
        </ul>
        <br />
    </div>

    <div>
        Regards.
    </div>
    <br />
    <p style="font-style: italic">
        This is an auto-mail. Please do not reply.
    </p>
</div>