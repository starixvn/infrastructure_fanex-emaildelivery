<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net461</TargetFrameworks>
    <CodeAnalysisRuleSet>Fanex.MailDelivery.Client.ruleset</CodeAnalysisRuleSet>
    <PackageId>Fanex.MailStation</PackageId>
    <Version>2.1.0</Version>
    <Authors>Nexcel Solutions</Authors>
    <Product>Fanex.MailStation</Product>
    <Description>Centralized all emails.</Description>
    <Copyright>Copyright 2021</Copyright>
    <PackageTags>MailStation</PackageTags>
    <PackageReleaseNotes>- Support .Net Core
 + Use default AppSetting (appsettings.json):      
     await MailClientHandler.StartAsync();

 + Use custom AppSetting (custom-appsettings.json):
     await MailClientHandler.StartAsync("custom-appsettings.json");
</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\.sonarlint\mailstation\CSharp\SonarLint.xml" Link="SonarLint.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.config.transform">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="web.config.transform">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EasyNetQ" Version="5.6.0" />
    <PackageReference Include="Fanex.Caching" Version="2.2.2" />
    <PackageReference Include="Fanex.Logging" Version="2.0.1" />
    <PackageReference Include="Fanex.Logging.Extensions" Version="1.0.6" />
    <PackageReference Include="Fanex.MailStation.Core" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="2.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="2.0.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Quartz" Version="3.2.4" />
  </ItemGroup>

</Project>
