<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>
 
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="MailCentralized" />
 
  <Fanex.MailDelivery.Client 
    applicationSendMailId="1" 
    siteId="1" 
    rabbitMQConnectionString="host=10.18.200.209,10.18.200.202;virtualHost=/philliphost;username=rabbitclient" 
    messageBrokerLogCategory="MailCentralized">
    <Functions>
      <add id="1" name="FuntionA" />
    </Functions>
    <Schedules>
      <!--<Schedule id="2" name="HelloSchedule" job="MailClientTest.Jobs.HelloJob, MailClientTest">
        --><!--<JobInputData>
          <add name="paramName1" value="paramValue" />
          <add name="paramName2" value="paramValue" />
        </JobInputData>--><!--
      </Schedule>-->
      <Schedule id="2" name="HelloSchedule" job="MailClientTest.Jobs.NormalJob, MailClientTest" />
      <Schedule id="91" name="HelloSchedule" job="MailClientTest.Jobs.ErrorJob, MailClientTest" />
      <Schedule id="94" name="HelloSchedule" job="MailClientTest.Jobs.UnstableJob, MailClientTest" />
    </Schedules>
  </Fanex.MailDelivery.Client>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
