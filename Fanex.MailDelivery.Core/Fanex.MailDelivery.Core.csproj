<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net461</TargetFrameworks>
    <Authors>Nexcel Solutions</Authors>
    <Version>2.0.0</Version>
    <Description>Core classes for sharing between the MailStation components</Description>
    <Copyright>Copyright 2021</Copyright>
    <PackageTags>MailStation</PackageTags>
    <PackageId>Fanex.MailStation.Core</PackageId>
    <Product>Fanex.MailStation.Core</Product>
    <CodeAnalysisRuleSet>Fanex.MailDelivery.Core.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\.sonarlint\mailstation\CSharp\SonarLint.xml" Link="SonarLint.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ONEbook.UM" Version="3.1.1" />
    <PackageReference Include="ONEbook.UM.Transport" Version="3.1.1" />
    <PackageReference Include="SimpleInjector" Version="5.3.2" />
    <PackageReference Include="TimeZoneConverter" Version="3.4.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
  </ItemGroup>
</Project>