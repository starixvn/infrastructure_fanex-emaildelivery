<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="common">
      <section name="logging" type="Common.Logging.ConfigurationSectionHandler, Common.Logging" />
    </sectionGroup>
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <appSettings>
    <add key="SentryDsn" value="http://f69637f5e4d54527bdb0d48acaa05938@10.99.99.51:801/110" />
    <add key="LogCategory" value="MailStationClientTest-UAT" />
    <add key="Environment" value="UAT"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <common>
    <logging>
      <factoryAdapter type="Common.Logging.Log4Net.Universal.Log4NetFactoryAdapter, Common.Logging.Log4Net.Universal" />
    </logging>
  </common>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <Fanex.MailDelivery.Client applicationSendMailId="1" siteId="8" rabbitMQConnectionString="host=10.99.99.101:5672;virtualHost=/MailStationHost-UAT;username=rabbitclient;timeout=120">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <Schedule id="349" name="SendMailJob" job="MailStationClient.AutoJobDemo.SendMailJob, MailStationClient.AutoJobDemo" />
      <!--<Schedule id="315" name="ErrorJob" job="MailStationClient.AutoJobDemo.ErrorJob, MailStationClient.AutoJobDemo" />-->
    </Schedules>
  </Fanex.MailDelivery.Client>
</configuration>