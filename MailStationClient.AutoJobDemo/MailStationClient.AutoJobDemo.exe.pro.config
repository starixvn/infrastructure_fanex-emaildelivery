<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>    
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <appSettings>
    <add key="SentryDsn" value="http://3746834112144eb18e10f401eacaa1ee@10.99.99.51:801/109" />
    <add key="LogCategory" value="MailStationClientTest" />
    <add key="Environment" value="PRO"/>
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup> 
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">     
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.InteropServices.RuntimeInformation" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.2.0" newVersion="4.0.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.1" newVersion="4.0.1.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <Fanex.MailDelivery.Client applicationSendMailId="1" siteId="8" rabbitMQConnectionString="host=10.99.99.51:5672;virtualHost=/MailStationHost;username=rabbitclient;timeout=120">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <Schedule id="353" name="SendMailJob" job="MailStationClient.AutoJobDemo.SendMailJob, MailStationClient.AutoJobDemo" />
      <!--<Schedule id="315" name="ErrorJob" job="MailStationClient.AutoJobDemo.ErrorJob, MailStationClient.AutoJobDemo" />-->
    </Schedules>
  </Fanex.MailDelivery.Client>
</configuration>