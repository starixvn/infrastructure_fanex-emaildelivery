@using Newtonsoft.Json;
@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Models;
@model RecipientModel
@{
    ViewBag.Title = "Manage Mail";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasEditRight = true;
    var hasSiteRight = true;
    var recipient = JsonConvert.SerializeObject(Model);
}
@section Head {
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/themes/fanexgridstyles")
    @Styles.Render("~/Areas/MailStation/ManageMail/ManageMailStyles")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">Mail Delivery System /</span> @ViewBag.Title</span>
        @if (hasEditRight)
        {
            <div class="button-action">
                <a id="btnCreateMail" class="add-button" href="~/MailStation/MailManage/CreateMailView">
                    + Create Mail</a>
            </div>
        }
    </h1>
}
<section id="filter-bar">
        <div class="filter-form">
            <div class="filter-row">
                <div class="form-group">
                    <div class="lbl-field width-80">
                        @Html.LabelFor(m => m.MailName, "Mail Name")
                    </div>
                    @Html.TextBoxFor(m => m.MailName, new { @class = "textbox" })
                </div>
                <div class="form-group">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.IsActive, "Status")
                    </div>
                    @Html.DropDownListFor(m => m.IsActive, (IEnumerable<SelectListItem>)ViewBag.ListStatus)
                </div>
                <div class="form-group">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.MailGroupID, "Group")
                    </div>
                    @Html.DropDownListFor(m => m.MailGroupID, (IEnumerable<SelectListItem>)ViewBag.ListMailGroup)
                </div>
                <div class="form-group form-group-right">
                    <input id="button-search" type="submit" value="Submit" />
                </div>
            </div>
            <div class="filter-row">
                <div class="form-group">
                    <div class="lbl-field width-80">
                        @Html.LabelFor(m => m.SiteID, "Site")
                    </div>
                    @Html.DropDownListFor(m => m.SiteID, (IEnumerable<SelectListItem>)ViewBag.ListSite)
                </div>
                <div class="form-group">
                    <div class="lbl-field width-80">
                        @Html.LabelFor(m => m.TriggerType, "Trigger")
                    </div>
                    @Html.DropDownListFor(m => m.TriggerType, (IEnumerable<SelectListItem>)ViewBag.ListTriggerType)
                </div>
                <div class="form-group">
                    <div class="lbl-field">
                        @Html.LabelFor(m => m.Emails, "Email(s)")
                    </div>
                    @Html.TextBoxFor(m => m.Emails, new { @class = "textbox" })
                </div>
            </div>
        </div>
    </section>
<section id="body">
    <div id="mail-list-container" class="mail-list-container">
        <div id="mail-list" class="freegrid display-none">
        </div>
    </div>
    <ul class="actions display-none">
        <li><a class="edit-icon context-menu-item">Edit</a> </li>
        <li><a class="copy-icon context-menu-item">Copy</a> </li>
        <li><a class="delete-icon context-menu-item">Delete</a> </li>
    </ul>
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    @Scripts.Render("~/Areas/MailStation/ManageMail/ManageMailScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var recipient= @Html.Raw(recipient); 
        var viewResources = {
            hasEditRight: @(hasEditRight ? 1 : 0),
            hasSiteRight: @(hasSiteRight ? 1 : 0),
            Id: 'ID',
            Mail_Name: 'Mail Name',
            Group: 'Group',
            Site: 'Site',
            Trigger: 'Trigger',
            To: 'To',
            CC: 'CC',
            BCC: 'BCC',
            Last_Sent: 'Last Sent',
            Active: 'Active',
            Action: 'Action',
            Confirm_DeleteMail: 'Do you want to delete the Mail?'
        };
    </script>
}
