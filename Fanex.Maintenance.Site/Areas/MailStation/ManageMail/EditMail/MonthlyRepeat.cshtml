<div class="monthly-schedule display-none">
    <div class="form-row">
        <div class="lbl-field">
            <label for="repeat-day-monthly" class="bold-weight">
                Repeat every
            </label>
        </div>
        <div class="edit-field">
            <select id="repeat-day-monthly" name="repeat-day" class="repeat-day">
            </select>
        </div>
        <div class="lbl-field day-time-separate-label">
            <label>
                months
            </label>
            <label for="repeat-time">
                at
            </label>
        </div>
        <div class="edit-field">
            <input id="repeat-time" type="text" value="" name="repeat-time" />
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="repeat-on-day" class="bold-weight">
                Repeat on:
            </label>
        </div>
        <div class="edit-field">
            <input id="repeat-on-day" type="text" value="30" name="repeat-on-day" />
        </div>
        <div class="lbl-field">
            <label>
                of each Month
            </label>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="start-day-monthly" class="bold-weight">
                Start on:
            </label>
        </div>
        <div class="edit-field">
            <input id="start-day-monthly" type="text" value="@DateTime.Now.ToString("MMM dd,yyyy")" />
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label class="bold-weight">
                Ends:
            </label>
        </div>
        <div class="edit-field">
            <label>
                <input type="radio" value="1" name="is-end-limit-monthly" />Never</label>
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
        </div>
        <div class="edit-field">
            <label>
                <input type="radio" value="2" name="is-end-limit-monthly" checked="checked" />On</label>
            <input id="end-day-monthly" type="text" value="@DateTime.Now.ToString("MMM dd,yyyy")" />
        </div>
    </div>
    <div class="form-row">
        <div class="lbl-field">
            <label for="attempt-count-monthly" class="bold-weight">
                Attempt
            </label>
        </div>
        <div class="edit-field">
            <select id="attempt-count-monthly" name="attempt-count" class="attempt-count">
            </select>
        </div>
        <div class="lbl-field separate-label-group">
            <label class="label-time">
                times
            </label>
            <label>
                Interval
            </label>
        </div>
        <div class="edit-field">
            <input id="interval-time" type="text" value="30" name="interval-time" />
        </div>
        <div class="lbl-field interval-time-label">
            <label>
                minute(s)
            </label>
        </div>
    </div>
</div>
