@using Fanex.MailDelivery.Client.Models;
@using Newtonsoft.Json
@model List<Mail>
@{
    ViewBag.Title = "Log Details";
    var mailLog = JsonConvert.SerializeObject(Model);
}
<!DOCTYPE html>
