@using Fanex.MailDelivery.Client.Models;
@model Mail
@{
    ViewBag.Title = "Mail Detail";
    Layout = "";  
}
<!DOCTYPE html>
<!--[if IEMobile 7]><html class="no-js iem7 oldie"><![endif]-->
<!--[if (IE 7)&!(IEMobile)]><html class="no-js ie7 oldie" lang="en"><![endif]-->
<!--[if (IE 8)&!(IEMobile)]><html class="no-js ie8 oldie" lang="en"><![endif]-->
<!--[if (IE 9)&!(IEMobile)]><html class="no-js ie9" lang="en"><![endif]-->
<!--[if (gt IE 9)|(gt IEMobile 7)]><!-->
<html lang="en" class="linen" ng-app="app">
<!--<![endif]-->
<head>
    <title>@ViewBag.Title</title>
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/Areas/MailStation/MailDetail/MailDetailStyles")
</head>
<body id="body">
    <div class="form">
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    From</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    forrest.nguyen@nexcel.vn</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    To</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    forrest.nguyen@nexcel.vn</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    CC</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    BCC</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    Mail Date</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    11/3/2014 2:43:47 AM</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    Title</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    [WEB DEPLOYMENT TOOL]</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    Subject</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Model.Subject</label>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field label-column-1">
                <label class="bold-weight">
                    Body</label>
            </div>
            <div class="lbl-field label-column-2">
                <label>
                    @Html.Raw(Model.Body)</label>
            </div>
        </div>
    </div>
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/Areas/MailStation/MailDetail/MailDetailScripts")
</body>
</html>
