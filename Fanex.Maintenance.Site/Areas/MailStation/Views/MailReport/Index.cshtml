@{
    ViewBag.Title = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasEditRight = true;
}
@section Head {
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/themes/fanexgridstyles")
    @Styles.Render("~/Areas/MailStation/MailReport/MailReportStyles")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">Mail Delivery System /</span> @ViewBag.Title</span>
    </h1>
}
<section id="filter-bar">
    <div class="filter-form">
        <div class="filter-row">
            <div class="form-group">
                <div class="lbl-field width-80">
                    <label for="mail-name">
                        Mail Name</label>
                </div>
                <input id="mail-name" type="text" class="textbox" />
            </div>
            <div class="form-group">
                <div class="lbl-field width-40">
                    <label for="from-date">
                        From
                    </label>
                </div>
                <div class="edit-field">
                    <input id="from-date" type="text" value="@DateTime.Now.ToString("MMM dd,yyyy")" />
                </div>
            </div>
            <div class="form-group">
                <div class="lbl-field width-40">
                    <label for="to-date">
                        To
                    </label>
                </div>
                <div class="edit-field">
                    <input id="to-date" type="text" value="@DateTime.Now.ToString("MMM dd,yyyy")" />
                </div>
            </div>
            <div class="form-group">
                <div class="lbl-field">
                    <label for="status">
                        Status</label>
                </div>
                <select id="status" name="status">
                </select>
            </div>
            <div class="form-group">
                <input id="button-search" type="submit" value="Submit" />
            </div>
            <div class="form-group">
                <div class="refreshBox">
                    <div class="refreshIcon" title="Refresh">
                        Not Refresh
                    </div>
                    <div class="refreshDropdownIcon">
                    </div>
                </div>
                <div class="countDownOptionContainer">
                    <div class="countDownOption countDownOptionCheck" value="Not Refresh">
                        Not Refresh</div>
                    <div class="countDownOption" value="5">
                        5s</div>
                    <div class="countDownOption" value="30">
                        30s</div>
                    <div class="countDownOption" value="60">
                        60s</div>
                    <div class="countDownOption" value="90">
                        90s</div>
                    <div class="countDownOption" value="120">
                        120s</div>
                    <div class="countDownOption" value="150">
                        150s</div>
                </div>
            </div>
        </div>
    </div>
</section>
<section id="body">
    <div id="mail-report-container" class="mail-report-container">
        <div id="mail-report" class="freegrid display-none">
        </div>
    </div>
    @Html.Hidden("imagePath", (string)@Url.Content("~/images/calendar.gif"))
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/scripts/fanexgridscripts")
    @Scripts.Render("~/Areas/MailStation/MailReport/MailReportScripts")
    <script type="text/javascript">
        window.rootUrl = '@Url.Content("~")';
        var viewResources = {
            hasEditRight: @(hasEditRight ? 1 : 0),
            Id: 'ID',
            Mail_Name: 'Mail Name',
            Site: 'Site',
            Scheduled_Time: 'Scheduled Time',
            Last_Sent: 'Last Sent',
            Status: 'Status',
            Action: 'Action',
            Log: 'Log',

            Details: 'Details',
            Log_details: 'Log details'
        };
    </script>
}
