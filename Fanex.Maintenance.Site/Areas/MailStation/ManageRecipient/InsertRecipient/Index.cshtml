@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Models;
@{
    ViewBag.Title = Labels.Insert_Recipient;
    Layout = "~/Views/Shared/_Layout.cshtml";  
}
@section Head {
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/scripts/inputcomboboxstyles")
    @Styles.Render("~/Areas/MailStation/InsertRecipient/InsertRecipientStyles")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.Mail_Delivery_System / </span><span
            class="second">
            @Labels.Manage_Recipient /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="back-button" href="~/MailStation/MailRecipient/Index">←
                @Labels.Back_to_list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field validation-summary">
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="username" class="bold-weight">
                    @Labels.Username</label>
            </div>
            <div class="edit-field">
                <input id="username" type="text" value="" name="username" />
            </div>
            <a id="btn-loading" class="ico-loading display-none"></a>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="email1">
                    @string.Format("{0} {1}", Labels.Email, 1)</label>
            </div>
            <div class="edit-field">
                <input id="email1" type="text" value="" name="email1" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="email2">
                    @string.Format("{0} {1}", Labels.Email, 2)</label>
            </div>
            <div class="edit-field">
                <input id="email2" type="text" value="" name="email2" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="email3">
                    @string.Format("{0} {1}", Labels.Email, 3)</label>
            </div>
            <div class="edit-field">
                <input id="email3" type="text" value="" name="email3" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                <label for="note">
                    @Labels.Note</label>
            </div>
            <div class="edit-field">
                <input id="note" type="text" value="" name="note" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                <label for="status">
                    @Labels.Status
                </label>
            </div>
            <div class="edit-field">
                <input class="check-box" id="status" name="status" type="checkbox" value="false" />
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
            </div>
            <input id="button-save" type="submit" value="@Labels.Save" />
            <button id="button-cancel" class="cancel-button">
                @Labels.Cancel</button>
        </div>
    </div>
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/Areas/MailStation/InsertRecipient/InsertRecipientScripts")
    <script type="text/javascript">
        var viewResources = {
            Confirm_CancelInsertRecipient: '@Labels.Confirm_CancelInsertRecipient',
            Confirm_InsertRecipient: '@Labels.Confirm_InsertRecipient'
        };
    </script>
}
