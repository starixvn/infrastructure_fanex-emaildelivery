@using Fanex.MailDelivery.MailStation.Resources;
@using Fanex.MailDelivery.MailStation.Models;
@model RecipientModel
@{
    ViewBag.Title = Labels.Edit_Recipient;
    Layout = "~/Views/Shared/_Layout.cshtml";  
}
@section Head {
    @Styles.Render("~/themes/sharedstyles")
    @Styles.Render("~/scripts/inputcomboboxstyles")
    @Styles.Render("~/Areas/MailStation/EditRecipient/EditRecipientStyles")
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@Labels.Mail_Delivery_System / </span><span
            class="second">@Labels.Manage_Recipient /</span>
            @ViewBag.Title
        </span>
        <div class="button-action">
            <a id="btnBackToList" class="lnk" href="~/MailStation/MailRecipient/Index">←
                @Labels.Back_to_list</a>
        </div>
    </h1>
}
<section id="body">
    <div class="form">
        <div id="validation-summary-row" class="form-row display-none">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <div id="validationSummary"></div>
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.RecipientName, new { @class = "bold-weight" })
                @*<label for="username" class="bold-weight">
                    @Labels.Username</label>*@
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.RecipientName, new { disabled = "disabled" })
                @*<input id="username" type="text" value="@Model.RecipientName" name="username" disabled="disabled" />*@
            </div>
            <a id="btn-loading" class="ico-tick display-none"></a>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email1, string.Format("{0} {1}", Labels.Email, 1))
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email1)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email2, string.Format("{0} {1}", Labels.Email, 2))
                @*<label for="email2">
                    @string.Format("{0} {1}", Labels.Email, 2)</label>*@
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email2)
                @*<input id="email2" type="text" value="@Model.Email2" name="email2" />*@
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Email3, string.Format("{0} {1}", Labels.Email, 3))
                @*<label for="email3">
                    @string.Format("{0} {1}", Labels.Email, 3)</label>*@
            </div>
            <div class="edit-field">
                @Html.EditorFor(m => m.Email3)
                @*<input id="email3" type="text" value="@Model.Email3" name="email3" />*@
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.Note, Labels.Note)
                @*<label for="note">
                    @Labels.Note</label>*@
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Note)
                @*<input id="note" type="text" value="@Model.Note" name="note" />*@
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
                @Html.LabelFor(m => m.IsActive, Labels.Status)
                @*<label for="status">
                    @Labels.Status
                </label>*@
            </div>
            <div class="edit-field">
                @Html.CheckBoxFor(m => m.IsActive)
                @*<input class="check-box" id="status" name="status" type="checkbox" value="false" 
                @(Model.IsActive ? "checked = \"checked\"" : "")/>*@
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field width-100">
            </div>
            <div class="edit-field">
                <input id="button-save" type="submit" value="@Labels.Save" />
                <input id="button-cancel" type="submit" value="@Labels.Cancel" />
            </div>
        </div>
    </div>
</section>
@section Foot {
    @Scripts.Render("~/scripts/sharedscripts")
    @Scripts.Render("~/Areas/MailStation/EditRecipient/EditRecipientScripts")
    <script type="text/javascript">
        var viewResources = {
            RecipientId: @Model.RecipientId,
            Confirm_CancelEditRecipient: '@Labels.Confirm_CancelEditRecipient',
            Confirm_EditRecipient: '@Labels.Confirm_EditRecipient'
        };
    </script>
}
