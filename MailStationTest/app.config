<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <!--<Fanex.MailDelivery.Client environment="dev" applicationSendMailId="68" siteId="97" rabbitMQConnectionString="host=10.18.200.227;virtualHost=/MailStationHost;username=rabbitclient;timeout=15">-->
  <Fanex.MailDelivery.Client applicationSendMailId="68" siteId="97" rabbitMQConnectionString="host=ha.nexdev.net:5672;virtualHost=/MailStationHost;username=rabbitclient;timeout=15" >
    <Functions>
      <add id="316" name="FuntionA" />
    </Functions>
    <Schedules>
      <Schedule id="313" name="HelloSchedule" job="MailStationClientTest.Jobs.NormalJob, MailStationClientTest" />
      <Schedule id="315" name="FailedSchedule" job="MailStationClientTest.Jobs.ErrorJob, MailStationClientTest" />
      <Schedule id="331" name="DataNotReadySchedule" job="MailStationClientTest.Jobs.DataNotReadyJob, MailStationClientTest" />
      <Schedule id="332" name="SucceedSchedule" job="MailStationClientTest.Jobs.SuccessWithoutSendMailJob, MailStationClientTest" />
      <Schedule id="333" name="UnstableSchedule" job="MailStationClientTest.Jobs.UnstableJob, MailStationClientTest" />
    </Schedules>
  </Fanex.MailDelivery.Client>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup> 
</configuration>
