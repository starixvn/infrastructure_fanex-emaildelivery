    <!--Fanex-->
    <log4net>
        <appender name="Fanex.MailService.Log" type="log4net.Appender.RollingFileAppender">
            <file value="Logs\" />
            <datePattern value="dd.MM.yyyy'.log'" />
            <rollingStyle value="Date" />
            <maxSizeRollBackups value="10" />
            <maximumFileSize value="2MB" />
            <staticLogFileName value="false" />
            <threshold value="ERROR" />
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
            </layout>
        </appender>
        <!--<logger name="Fanex.MailDeliver.Core.Infrastructure.Logging.LogExtention">-->
        <root>
            <level value="ERROR" />
            <level value="ALL" />
            <appender-ref ref="Fanex.MailService.Log" />
            <!--</logger>-->
        </root>
    </log4net>
    <!--Fanex-->
    <appSettings>
        <add key="app_mail_address" value="net.tcp://ha.nexdev.net:8787/mailservice" />
        <add key="app_mail_id" value="1" />
        <add key="ClientSettingsProvider.ServiceUri" value="" />
        <add key="ServiceName" value="Fanex.MailStation.Service" />
