<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="MailSection" type="Fanex.MailDeliver.Core.Infrastructure.Configurations.MailSection, Fanex.MailDeliver.Core" />
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <appSettings>
    <add key="app_mail_address" value="net.tcp://172.16.4.106:8585/mailservice" />
    <add key="app_mail_id" value="1" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="MailStation:RabbitMQConnectionString" value="host=172.16.4.106,172.16.4.107;virtualHost=/MailStationHost;username=rabbitclient;timeout=60" />
    <add key="MailStation:SendMailRetryLimit" value="5" />
    <add key="MailStation:SendMailRetryIntervalInMinutes" value="10" />
    <add key="MailStation:CheckUMIntervalInMinutes" value="5" />
    <add key="MailStation:UpdateFailedForLongRunningTaskIntervalInMinutes" value="30" />
    <add key="ONEbook.UM:ServiceUri" value="http://172.16.4.106:8889/api" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <MailSection>
    <Attachment storeMode="Binary">
      <Extensions>
        <add name="MS_EXCEL" type="application/ms-excel"></add>
        <add name="MS_DOC" type="application/ms-doc"></add>
        <add name="IMG_JPG" type="image/jpeg"></add>
        <add name="IMG_GIF" type="image/gif"></add>
        <add name="IMG_PNG" type="image/png"></add>
        <add name="PDF" type="application/pdf"></add>
        <add name="TEXT" type="text/plain"></add>
      </Extensions>
    </Attachment>
  </MailSection>
  <log4net>
    <appender name="MailStation.Log" type="log4net.Appender.RollingFileAppender">
      <file value="Logs\" />
      <datePattern value="'mail.'yyyy.MM.dd'.log'" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <rollingStyle value="Date" />
      <maxSizeRollBackups value="10" />
      <maximumFileSize value="2MB" />
      <staticLogFileName value="false" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>
    <root>
      <level value="ALL" />
      <appender-ref ref="MailStation.Log" />
    </root>
  </log4net>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:172.16.4.106\private$\entlib" defaultCategory="MailStation-SIT" />
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.DbSettingProviderExtension.XmlDbSettingProvider3, Fanex.Data.DbSettingProviderExtension" resourcePath="AppData\StoreProcedureName.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings>
    <add name="DBMA.bodb_Maintenance.bodbAdminNet" connectionString="packet size=4096; Data Source=172.16.40.6;Asynchronous Processing=true;Initial Catalog=bodb_Maintenance;integrated security=false; user id=bodbAdminNet; password=j+UGweaEw4d2X3mfHMROgA==;" providerName="System.Data.SqlClient"/>
    <add name="DBMMS.bodb_MMS.bodbAdminNet" connectionString="packet size=4096; Data Source=172.16.40.6;Asynchronous Processing=true;Initial Catalog=bodb_MMS;integrated security=false; user id=bodbAdminNet; password=j+UGweaEw4d2X3mfHMROgA==;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="RabbitMQ.Client" publicKeyToken="89e7d7c5feba84ce" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.6.10.0" newVersion="2.6.10.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>