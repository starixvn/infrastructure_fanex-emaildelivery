  <Fanex.MailDelivery.Client requestRetryIntervalInSeconds="1" requestRetryLimit="1" environment="dev" applicationSendMailId="68" siteId="97" rabbitMQConnectionString="host=10.18.200.227;virtualHost=/MailStationHost;username=rabbitclient;timeout=15">
