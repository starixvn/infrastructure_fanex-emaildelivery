<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="Fanex.MailDelivery.Client" type="Fanex.MailDelivery.Client.Configurations.MailClientSection, Fanex.MailDelivery.Client" />
  </configSections>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="log4net" publicKeyToken="669e0ddf0bb1aa2a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.15.0" newVersion="1.2.15.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" filePath="$FilePath" />
  <Fanex.MailDelivery.Client environment="dev" applicationSendMailId="68" siteId="97" rabbitMQConnectionString="host=10.18.200.227;virtualHost=/MailStationHost;username=rabbitclient;timeout=15">
    <Functions>
      <!--<add id="1" name="YourFunction" />-->
    </Functions>
    <Schedules>
      <Schedule id="1" name="TestJob" job="Fanex.MailDelivery.Client.Tests.TestJob, Fanex.MailDelivery.Client.Tests" />
    </Schedules>
  </Fanex.MailDelivery.Client>
</configuration>